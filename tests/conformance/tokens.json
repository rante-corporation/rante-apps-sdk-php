{
  "description": "Token verification cases every Rante Apps server SDK passes (docs/tokens.md). A test harness signs each case with keys it generates, serves them as a JWKS from a local OpenID configuration at {authority}/common/v2.0/.well-known/openid-configuration, verifies the token and compares the error code (null = accepted). Placeholders: $authority, $clientId, $CLIENTID (upper case), $tenantId, $TENANTID, $otherTenantId, $userId are replaced inside every string; a whole string \"$now\", \"$now+N\" or \"$now-N\" becomes that Unix time in seconds; $iss means \"$authority/$tenantId/v2.0\". In claims, null removes the claim from the base. sign: key-1 (default, RS256, in the JWKS), other-key (RS256, not in the JWKS, header kid key-1), es256 (ES256 key ec-1, in the JWKS), hs256-public-key (HMAC-SHA256 with key-1's public key in PEM as the secret, header alg HS256), none (header alg none, empty signature). tamper: change oid in the payload after signing. raw: the literal token. options: verifier options (tenants, requiredScopes).",
  "version": 1,
  "clientId": "3f2b8c1e-7d4a-4e9b-a6c5-1d2e3f4a5b6c",
  "tenantId": "7c6f2a10-5b3e-4d8a-9f21-0e4d6b8c1a2f",
  "otherTenantId": "0b1c2d3e-4f50-4a6b-8c7d-9e0f1a2b3c4d",
  "userId": "5e8d7c6b-4a39-4281-9f0e-1d2c3b4a5f60",
  "header": { "alg": "RS256", "kid": "key-1", "typ": "JWT" },
  "claims": {
    "iss": "$iss",
    "aud": "$clientId",
    "tid": "$tenantId",
    "oid": "$userId",
    "sub": "Xb3v0aE9rT2lQ8nK5mW1yZ7pC4dF6gH0jL2sN9uV",
    "azp": "rante-portal",
    "idtyp": "user",
    "ver": "2.0",
    "name": "Ada Lovelace",
    "preferred_username": "ada@example.com",
    "scp": "user.read tenant.read auth.token",
    "iat": "$now",
    "nbf": "$now",
    "exp": "$now+900"
  },
  "cases": [
    {
      "name": "a valid token",
      "expect": null,
      "principal": {
        "userId": "$userId",
        "tenantId": "$tenantId",
        "subject": "Xb3v0aE9rT2lQ8nK5mW1yZ7pC4dF6gH0jL2sN9uV",
        "name": "Ada Lovelace",
        "username": "ada@example.com",
        "authorizedParty": "rante-portal",
        "scopes": ["user.read", "tenant.read", "auth.token"]
      }
    },
    { "name": "aud is an array that contains the client ID", "claims": { "aud": ["api://another-app", "$clientId"] }, "expect": null },
    { "name": "the client ID in upper case", "claims": { "aud": "$CLIENTID" }, "expect": null },
    { "name": "no optional claims", "claims": { "nbf": null, "iat": null, "idtyp": null, "name": null, "preferred_username": null, "azp": null, "scp": null }, "expect": null },
    { "name": "expired beyond the clock skew", "claims": { "exp": "$now-120" }, "expect": "token_expired" },
    { "name": "expired within the clock skew", "claims": { "exp": "$now-30" }, "expect": null },
    { "name": "not valid yet", "claims": { "nbf": "$now+300" }, "expect": "invalid_token" },
    { "name": "issued in the future", "claims": { "iat": "$now+300" }, "expect": "invalid_token" },
    { "name": "no exp", "claims": { "exp": null }, "expect": "invalid_token" },
    { "name": "another app's token", "claims": { "aud": "00000000-1111-2222-3333-444444444444" }, "expect": "invalid_token" },
    { "name": "no aud", "claims": { "aud": null }, "expect": "invalid_token" },
    { "name": "an issuer on another host", "claims": { "iss": "https://login.example.com/$tenantId/v2.0" }, "expect": "invalid_token" },
    { "name": "an issuer for another tenant than tid", "claims": { "iss": "$authority/$otherTenantId/v2.0" }, "expect": "invalid_token" },
    { "name": "the common issuer", "claims": { "iss": "$authority/common/v2.0" }, "expect": "invalid_token" },
    { "name": "no iss", "claims": { "iss": null }, "expect": "invalid_token" },
    { "name": "no tid", "claims": { "tid": null }, "expect": "invalid_token" },
    { "name": "tid is not a GUID", "claims": { "tid": "contoso", "iss": "$authority/contoso/v2.0" }, "expect": "invalid_token" },
    { "name": "no oid", "claims": { "oid": null }, "expect": "invalid_token" },
    { "name": "an app-only token", "claims": { "idtyp": "app" }, "expect": "invalid_token" },
    { "name": "alg none", "sign": "none", "expect": "invalid_token" },
    { "name": "HS256 with the public key as the secret", "sign": "hs256-public-key", "expect": "invalid_token" },
    { "name": "ES256 when only RS256 is allowed", "sign": "es256", "expect": "invalid_token" },
    { "name": "an unknown key ID", "header": { "kid": "key-unknown" }, "expect": "invalid_token" },
    { "name": "signed with a key that is not in the JWKS", "sign": "other-key", "expect": "invalid_token" },
    { "name": "a payload changed after signing", "tamper": true, "expect": "invalid_token" },
    { "name": "two parts only", "raw": "eyJhbGciOiJSUzI1NiJ9.eyJzdWIiOiJ4In0", "expect": "invalid_token" },
    { "name": "not a JWT", "raw": "not-a-token", "expect": "invalid_token" },
    { "name": "an empty token", "raw": "", "expect": "missing_token" },
    { "name": "a tenant that is not allowed", "options": { "tenants": ["$otherTenantId"] }, "expect": "tenant_not_allowed" },
    { "name": "an allowed tenant, listed in upper case", "options": { "tenants": ["$TENANTID"] }, "expect": null },
    { "name": "a missing required scope", "options": { "requiredScopes": ["notifications"] }, "expect": "insufficient_scope" },
    { "name": "required scopes that are present", "options": { "requiredScopes": ["user.read", "auth.token"] }, "expect": null },
    { "name": "no scp while a scope is required", "claims": { "scp": null }, "options": { "requiredScopes": ["user.read"] }, "expect": "insufficient_scope" }
  ]
}
