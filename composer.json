{
    "name": "rante/apps-sdk",
    "description": "Rante Apps server SDK for PHP: verify the access tokens Rante.getAccessToken() gives your app, on firebase/php-jwt.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/rante-corporation/rante-apps-sdk-php",
    "authors": [
        {
            "name": "Rante Corporation"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "firebase/php-jwt": "^7.2",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Rante\\Apps\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rante\\Apps\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
